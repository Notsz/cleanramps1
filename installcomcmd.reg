Windows Registry Editor Version 5.00

; ---------- "Notsz Tweaks" - item que nao faz nada (sem subchave command) ----------
[HKEY_CLASSES_ROOT\DesktopBackground\Shell\NotszTweaksPlaceholder]
"MUIVerb"="Notsz Tweaks"
"Icon"="C:\\Notsz\\notsz.ico"
"Position"="Top"

[HKEY_CLASSES_ROOT\DesktopBackground\Shell\NotszTweaksPlaceholder\command]
@=powershell -WindowStyle Hidden -Command "Add-Type -AssemblyName PresentationFramework;[System.Windows.MessageBox]::Show('ola <3','Notsz Tweaks')"

; ---------- "Limpar RAM (Notsz)" - roda o clean-ram.ps1 via launcher ----------
[HKEY_CLASSES_ROOT\DesktopBackground\Shell\NotszCleanRAM]
"MUIVerb"="Limpar RAM"
"Icon"="C:\\Notsz\\ramnotsz.ico"

[HKEY_CLASSES_ROOT\DesktopBackground\Shell\NotszCleanRAM\command]
@="\"C:\\Notsz\\clean-ram-launcher.bat\""
